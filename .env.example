# Frontend / Authing
NUXT_PUBLIC_AUTHING_APP_ID=
NUXT_AUTHING_APP_SECRET=
NUXT_AUTH_BRIDGE_SECRET=
NUXT_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
NUXT_PUBLIC_AUTHING_HOST=https://core.authing.cn
NUXT_PUBLIC_AUTHING_ISSUER=
NUXT_PUBLIC_SITE_URL=http://localhost:3001
NUXT_BACKEND_URL=http://localhost:8081

# Database
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=aniglow
MYSQL_USER=aniglow
MYSQL_PASSWORD=

# Redis
REDIS_PASSWORD=

# Authentication
JWT_SECRET=
AUTH_BRIDGE_SECRET=
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# AIGC provider（Spring AI 统一接口，OpenAI 兼容端点均可）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# 图片对象存储（local=本地磁盘 | oss=阿里云OSS；留空 local 即可本地开发）
STORAGE_TYPE=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：绑定已备案的自定义域名（如 https://cdn.mjj520.top），留空则用 Bucket 默认域名
OSS_CUSTOM_DOMAIN=
